# --- LiveKit (transport + agent dispatch) -----------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Worker registers under this name; the dispatch script targets it.
AGENT_NAME=zoom-bot

# --- LemonSlice (avatar video) ----------------------------------------------
LEMONSLICE_API_KEY=

# Only used as a fallback when no local file is given for the avatar. LemonSlice
# fetches this itself, so it must be publicly reachable -- a LAN address like
# https://192.168.x.x:3000/uploads/... will NOT work. Prefer dropping an image
# in avatars/ and passing it as `image` in the dispatch metadata.
LEMONSLICE_IMAGE_URL=

# --- Fish Audio (cloned voice) ----------------------------------------------
# From https://fish.audio/app/api-keys. A system environment variable of the
# same name also works, but keeping it here makes the project portable.
FISH_API_KEY=

# Voice used when none is chosen in the interface. A Fish Audio voice model id
# from your own account. Leave empty to use the Fish plugin's public default.
DEFAULT_VOICE_ID=

# --- Who the avatar stands in for -----------------------------------------
# It gets asked "who is your owner?" and needs an answer. Also used in the
# opening line and in the notes.
OWNER_NAME=

# What the avatar is called in the participant list, and the name people say to
# get its attention. Defaults to "<OWNER_NAME> (AI)", or "Avatar (AI)".
BOT_NAME=

# --- Appearance (optional) -------------------------------------------------
# Your name in the interface header. Drop a square logo-small.png in brand/ to
# show your own mark beside it; without one, no logo is shown.
BRAND_NAME=

# --- Reaching the interface from your phone (optional) ---------------------
# The control panel answers on this machine only, by default. It can start
# processes and send an avatar into a meeting, so anything that can reach it can
# do those things. Set this to 1 to also answer on your local network -- the
# window prints the address to use. Still not reachable from outside your
# router, and Windows Firewall may need to be told to allow the port.
ALLOW_LAN=

# --- Only speak when spoken to: follow-ups ---------------------------------
# With the address gate on, the avatar answers when it hears its name. Nobody
# says a name twice in a row, so for this many seconds after it finishes
# speaking an unaddressed remark still counts as aimed at it. The cap is what
# stops it chaining replies into a conversation it is not part of. Set either
# to 0 to turn the whole thing off and require the name every time.
FOLLOW_UP_SECONDS=15
FOLLOW_UP_MAX=2

# --- Joining --------------------------------------------------------------
# Seconds to wait after the avatar appears before it speaks its opening line.
# The meeting's audio path takes a moment to come up; speaking too early means
# the avatar is heard joining mid-sentence. Raise this if that still happens.
JOIN_DELAY_SECONDS=3.5

# --- Meeting notes: formats ------------------------------------------------
# What to render the recap as, alongside the markdown. "pdf" (default),
# "docx", "both", a comma-separated list, or "none" for markdown only.
NOTES_FORMATS=pdf

# --- Meeting notes: emailing (optional) ------------------------------------
# Leave NOTES_EMAIL_TO empty to disable emailing entirely. Comma-separate for
# more than one recipient.
NOTES_EMAIL_TO=
NOTES_EMAIL_FROM=

# Gmail requires a 16-character App Password with 2-Step Verification enabled --
# your normal account password will be rejected:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (default, port 587), ssl (port 465), or none
SMTP_TLS=starttls

# Test the settings before a real meeting:
#   uv run python src/mailer.py
